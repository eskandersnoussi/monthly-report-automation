# Copy to ".env" and fill in. Never commit .env to GitHub.

# Name shown at the top of the report
COMPANY_NAME=Nordlys Pharmacy (fictional demo)

# Email settings, only needed for: python report.py --email
# Microsoft 365 / Outlook: smtp.office365.com, port 587
# Gmail: smtp.gmail.com, port 587 (use an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_FROM=
# One or more addresses, separated by commas
REPORT_TO=
